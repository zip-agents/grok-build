# Copy to .env for local development. Real environment variables win.
# .env is gitignored and excluded from the image.

# TCP port. The process listens on 0.0.0.0. Default: 8000.
PORT=8000

# DEBUG, INFO, WARNING, or ERROR. Default: INFO.
LOG_LEVEL=INFO

# DEFLATE level 1-9. 0 means the STORED method, not DEFLATE level 0. Default: 6.
ZIP_COMPRESSION_LEVEL=6

# Seconds to let in-flight zip requests finish after SIGTERM. 0 is allowed. Default: 25.
SHUTDOWN_GRACE_SECONDS=25

# Maximum non-skipped file parts in one request. Default: 500.
MAX_FILES=500

# Maximum in-flight zip requests per process. Health checks are not counted. Default: 32.
MAX_CONCURRENT_REQUESTS=32

# Seconds with no request-body bytes read and no response-body bytes sent. Default: 30.
IDLE_TIMEOUT_SECONDS=30

# Maximum total request duration in seconds. Default: 900.
MAX_REQUEST_DURATION_SECONDS=900

# Maximum compressed output held while the client is not reading. Default: 16777216 (16 MiB).
OUTPUT_BUFFER_MAX_BYTES=16777216
